---
import OzToolShell from '@chirag127/oz-chrome/components/OzToolShell.astro'
import { pwaInfo } from 'virtual:pwa-info'
import '../styles/global.css'
import '../styles/console.css'

interface Props {
  title?: string
  description?: string
}
const {
  title = 'oriz-tts — Text to Speech console',
  description = 'Free, private text-to-speech in your browser. Pick a voice, dial in rate & pitch, watch words light up as they are spoken. 100% client-side — nothing uploaded.',
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#24e0e0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tts.oriz.in" />
    <link rel="canonical" href="https://tts.oriz.in" />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <script src="/registerSW.js" is:inline></script>
  </head>
  <body>
    <OzToolShell site="tts" title="Text to Speech">
      <slot />
      <Fragment slot="footer">
        <a href="https://github.com/chirag127/oriz-tts">Source</a>
        <a href="https://oriz.in">More oriz tools</a>
      </Fragment>
    </OzToolShell>
  </body>
</html>
