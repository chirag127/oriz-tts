{
  "name": "oriz-tts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:submodules": "node scripts/check-submodules.mjs",
    "audit:repos": "node scripts/repo-audit.mjs",
    "api:discover": "node scripts/playwright-discover.mjs",
    "api:refresh": "node scripts/refresh-static-api.mjs",
    "api:factory": "node scripts/api-repo-factory.mjs",
    "api:pilot": "node scripts/api-repo-factory.mjs --pilot",
    "api:pilot:dry": "node scripts/api-repo-factory.mjs --dry-run --pilot",
    "api:publish": "node scripts/publish-api-repos.mjs --all",
    "test": "vitest run",
    "deploy": "astro build && wrangler pages deploy dist --project-name oriz-tts --branch main --commit-dirty=true"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.0",
    "@astrojs/sitemap": "^3.6.0",
    "@chirag127/oz-ai": "^0.3.2",
    "@chirag127/oz-chrome": "^0.1.0",
    "@chirag127/oz-file": "^0.1.0",
    "@chirag127/oz-tokens-base": "^0.1.0",
    "@fontsource-variable/nunito": "^5.2.5",
    "@fontsource-variable/space-grotesk": "^5.2.5",
    "@tailwindcss/vite": "^4.1.13",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^6.4.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.42.0"
  }
}
